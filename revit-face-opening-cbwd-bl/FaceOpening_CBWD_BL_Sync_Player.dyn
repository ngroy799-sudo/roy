        },
        {
          "Id": "pi3",
          "Name": "IN[3]",
          "Description": "ParameterName",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "pi4",
          "Name": "IN[4]",
          "Description": "ReportPath",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "po0",
          "Name": "OUT",
          "Description": "Player results list",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Loads sync_cbwd_bl.py. ProjectRoot may be dynamo/ (Player folder) or project root.",
      "VariableInputPorts": true,
      "Script": "import sys, os\ndef _s(v):\n    if v is None:\n        return ''\n    try:\n        return v.ToString() if hasattr(v, 'ToString') else str(v)\n    except:\n        return str(v)\n\ndef _is_root(p):\n    return (\n        p and os.path.isdir(p)\n        and os.path.isfile(os.path.join(p, 'python', 'sync_cbwd_bl.py'))\n        and os.path.isfile(os.path.join(p, 'config', 'sync_rules.json'))\n    )\n\ndef resolve_root(raw):\n    path = _s(raw).strip().strip('\"').strip(\"'\")\n    if (not path) or path.lower() in ('paste_your_path_here', 'your_path', 'todo', '(auto)', 'auto', 'null', 'none'):\n        return None, 'Paste ProjectRoot = Dynamo Player folder (dynamo) OR project folder'\n    if path.lower().endswith('.dyn') and os.path.isfile(path):\n        path = os.path.dirname(path)\n    if not os.path.isdir(path):\n        return None, 'Path not found: ' + path\n    cands = [path]\n    if os.path.basename(os.path.normpath(path)).lower() == 'dynamo':\n        cands.append(os.path.dirname(path))\n    parent = os.path.dirname(os.path.normpath(path))\n    if parent and parent not in cands:\n        cands.append(parent)\n    for c in cands:\n        if _is_root(c):\n            return c, ''\n    return None, 'Need ...\\\\revit-face-opening-cbwd-bl or ...\\\\dynamo (Player folder is OK)'\n\nOUT = ['init', '', 0, 0, 'init', 'ERROR']\ntry:\n    root, note = resolve_root(IN[0] if len(IN) > 0 else '')\n    if not root:\n        OUT = ['ProjectRoot could not be resolved', '', 0, 0, note, 'ERROR']\n    else:\n        py = os.path.join(root, 'python')\n        script = os.path.join(py, 'sync_cbwd_bl.py')\n        if py not in sys.path:\n            sys.path.insert(0, py)\n        # Rewrite IN[0] to resolved root for sync_cbwd_bl\n        inputs = list(IN)\n        while len(inputs) < 5:\n            inputs.append(None)\n        inputs[0] = root\n        ns = {'IN': inputs, 'OUT': None}\n        f = open(script, 'r')\n        code = f.read()\n        f.close()\n        exec(code, ns)\n        out = ns.get('OUT')\n        if out is None and callable(ns.get('run')):\n            out = ns['run'](inputs)\n        if out is None or (not isinstance(out, list)) or len(out) < 6:\n            OUT = ['Bad OUT from sync_cbwd_bl', '', 0, 0, 'Script did not return 6 outputs', 'ERROR']\n        else:\n            OUT = list(out)[:6]\n            if note:\n                # prepend resolve note into warnings slot\n                w = _s(OUT[4])\n                OUT[4] = (note + '; ' + w) if w and w != 'none' else note\nexcept Exception as ex:\n    try:\n        import traceback\n        tb = traceback.format_exc()\n    except:\n        tb = str(ex)\n    OUT = ['Loader exception: ' + str(ex), '', 0, 0, tb, 'ERROR']\n"
    },
