      "ConcreteType": "PythonNodeModels.PythonNode",
      "NodeType": "PythonScriptNode",
      "Engine": "IronPython2",
      "Id": "py-player-loader",
      "Inputs": [
        {
          "Id": "pi0",
          "Name": "IN[0]",
          "Description": "ProjectRoot",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
