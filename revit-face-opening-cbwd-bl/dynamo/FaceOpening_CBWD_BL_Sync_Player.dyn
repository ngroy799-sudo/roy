        }
      ],
      "Outputs": [
        {
          "Id": "po0",
          "Name": "OUT",
          "Description": "Player results list",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Loads python/sync_cbwd_bl.py from ProjectRoot and runs sync",
      "VariableInputPorts": true,
      "Script": "import sys, os\ndef _s(v):\n    if v is None:\n        return ''\n    try:\n        return v.ToString() if hasattr(v, 'ToString') else str(v)\n    except:\n        return str(v)\nroot = _s(IN[0]).strip().strip('\"')\nif not root:\n    OUT = ['ProjectRoot empty', '', 0, 0, 'Set ProjectRoot', 'ERROR']\nelse:\n    py = os.path.join(root, 'python')\n    if py not in sys.path:\n        sys.path.insert(0, py)\n    try:\n        import sync_cbwd_bl\n        try:\n            reload(sync_cbwd_bl)\n        except Exception:\n            try:\n                import importlib\n                importlib.reload(sync_cbwd_bl)\n            except Exception:\n                pass\n        OUT = sync_cbwd_bl.run(IN)\n    except Exception as ex:\n        OUT = ['Loader failed: ' + str(ex), '', 0, 0, str(ex), 'ERROR']\n"
    },
