    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\nclr.AddReference(\"RevitAPI\")\nclr.AddReference(\"RevitServices\")\nclr.AddReference(\"RevitNodes\")\n\nfrom Autodesk.Revit.DB import (\n    FilteredElementCollector, BuiltInCategory,\n    BoundingBoxXYZ, XYZ, ElementId,\n)\nfrom Autodesk.Revit.DB.Plumbing import PipeInsulation\nfrom Autodesk.Revit.DB.Mechanical import DuctInsulation\nfrom RevitServices.Persistence import DocumentManager\n\nimport Revit\nclr.ImportExtensions(Revit.Elements)\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nFPM = 1.0 / 304.8\n\nSUP = {\n    int(BuiltInCategory.OST_PipeCurves),\n    int(BuiltInCategory.OST_DuctCurves),\n}\n\ndef uw(e):\n    try:\n        return e.InternalElement\n    except:\n        return e\n\ndef uwl(els):\n    if not isinstance(els, (list, tuple)):\n        els = [els]\n    return [uw(e) for e in els if e is not None]\n\ndef cid(e):\n    return e.Category.Id.IntegerValue if e.Category else -1\n\ndef f2m(ft):\n    return ft / FPM\n\nclass Env(object):\n    def __init__(self, eid, mnx, mny, mnz, mxx, mxy, mxz, ins, cat):\n        self.eid = eid\n        self.mnx = mnx\n        self.mny = mny\n        self.mnz = mnz\n        self.mxx = mxx\n        self.mxy = mxy\n        self.mxz = mxz\n        self.ins = ins\n        self.cat = cat\n    @property\n    def otz(self):\n        return self.mxz\n    @property\n    def obz(self):\n        return self.mnz\n    def oxy(self, o):\n        return (self.mnx < o.mxx and self.mxx > o.mnx and\n                self.mny < o.mxy and self.mxy > o.mny)\n\ndef fi(doc, hid):\n    out = []\n    for b, c in [(BuiltInCategory.OST_PipeInsulations, PipeInsulation),\n                 (BuiltInCategory.OST_DuctInsulations, DuctInsulation)]:\n        try:\n            col = (FilteredElementCollector(doc)\n                   .OfCategory(b)\n                   .WhereElementIsNotElementType()\n                   .ToElements())\n            for i in col:\n                if i.HostElementId == hid:\n                    out.append(i)\n        except:\n            pass\n    return out\n\ndef ge(elem, doc):\n    bb = elem.get_BoundingBox(None)\n    if bb is None:\n        return None\n    hid = elem.Id\n    ins = fi(doc, hid)\n    hi = len(ins) > 0\n    mnx, mny, mnz = bb.Min.X, bb.Min.Y, bb.Min.Z\n    mxx, mxy, mxz = bb.Max.X, bb.Max.Y, bb.Max.Z\n    for i in ins:\n        ib = i.get_BoundingBox(None)\n        if ib is None:\n            continue\n        mnx = min(mnx, ib.Min.X)\n        mny = min(mny, ib.Min.Y)\n        mnz = min(mnz, ib.Min.Z)\n        mxx = max(mxx, ib.Max.X)\n        mxy = max(mxy, ib.Max.Y)\n        mxz = max(mxz, ib.Max.Z)\n    cn = elem.Category.Name if elem.Category else \"\"\n    return Env(hid.IntegerValue, mnx, mny, mnz, mxx, mxy, mxz, hi, cn)\n\nclass CZ(object):\n    def __init__(self, sid, me, oe, gap, req):\n        self.sid = sid\n        self.oids = [oe.eid]\n        self.me = me\n        self.oes = [oe]\n        self.gap = gap\n        self.req = req\n        self.wbz = oe.obz\n        self.ox0 = max(me.mnx, oe.mnx)\n        self.ox1 = min(me.mxx, oe.mxx)\n        self.oy0 = max(me.mny, oe.mny)\n        self.oy1 = min(me.mxy, oe.mxy)\n        self.sk = None\n    @property\n    def ic(self):\n        return self.gap < self.req\n    def mg(self, o):\n        self.oids.extend(o.oids)\n        self.oes.extend(o.oes)\n        self.wbz = min(self.wbz, o.wbz)\n        self.gap = min(self.gap, o.gap)\n        self.ox0 = min(self.ox0, o.ox0)\n        self.ox1 = max(self.ox1, o.ox1)\n        self.oy0 = min(self.oy0, o.oy0)\n        self.oy1 = max(self.oy1, o.oy1)\n\ndef det(se, oe, cm):\n    rq = cm * FPM\n    out = {}\n    for m in se:\n        zs = []\n        for o in oe:\n            if not m.oxy(o):\n                continue\n            if m.mnz >= o.mxz:\n                g = m.mnz - o.mxz\n            elif o.mnz >= m.mxz:\n                g = o.mnz - m.mxz\n            else:\n                g = -1.0\n            z = CZ(m.eid, m, o, g, rq)\n            if z.ic:\n                zs.append(z)\n        if zs:\n            out[m.eid] = zs\n    return out\n\ndef mzn(cd, gm):\n    mgf = gm * FPM\n    for sid, zs in cd.items():\n        if len(zs) <= 1:\n            continue\n        zs.sort(key=lambda z: z.ox0)\n        mr = [zs[0]]\n        for z in zs[1:]:\n            p = mr[-1]\n            if (z.ox0 - p.ox1) < mgf and (p.oy0 < z.oy1 and p.oy1 > z.oy0):\n                p.mg(z)\n            else:\n                mr.append(z)\n        cd[sid] = mr\n    return cd\n\ndef rpt(cd, sk):\n    ls = []\n    cc = 0\n    ls.append(\"=\" * 60)\n    ls.append(\"  MEP CLASH / CLEARANCE REPORT\")\n    ls.append(\"  Clearance target (incl. insulation)\")\n    ls.append(\"=\" * 60)\n    ls.append(\"\")\n    if not cd and not sk:\n        ls.append(\"No clashes detected. All clear.\")\n        return \"\\n\".join(ls), 0, len(sk)\n    for sid, zones in sorted(cd.items()):\n        for z in zones:\n            cc += 1\n            ls.append(\"[CLASH] Subject #{} ({})\".format(sid, z.me.cat))\n            ls.append(\"  vs Obstacle(s): {}\".format(\n                \", \".join(\"#{}\".format(o) for o in z.oids)))\n            gm = f2m(z.gap)\n            rm = f2m(z.req)\n            if z.gap < 0:\n                ls.append(\"  Gap: INTERSECTING\")\n            else:\n                ls.append(\"  Gap: {:.0f} mm  (required: {:.0f} mm)\".format(gm, rm))\n            ls.append(\"  MEP top Z: {:.1f} mm | Obstacle bottom Z: {:.1f} mm\".format(\n                f2m(z.me.otz), f2m(z.wbz)))\n            ls.append(\"  MEP insulated: {}\".format(\"Yes\" if z.me.ins else \"No\"))\n            for oe in z.oes:\n                ls.append(\"    Obs #{} ({}) insulated: {}\".format(\n                    oe.eid, oe.cat, \"Yes\" if oe.ins else \"No\"))\n            ls.append(\"\")\n    if sk:\n        ls.append(\"-\" * 40)\n        ls.append(\"SKIPPED (unsupported type):\")\n        for sid, r, d in sk:\n            ls.append(\"  #{} - {} ({})\".format(sid, r, d))\n        ls.append(\"\")\n    sc = len(sk)\n    ls[4] = \"Clashes: {}  |  Skipped: {}\".format(cc, sc)\n    return \"\\n\".join(ls), cc, sc\n\n# MAIN\nsubjects_raw = IN[0] if isinstance(IN[0], list) else [IN[0]] if IN[0] else []\nobstacles_raw = IN[1] if isinstance(IN[1], list) else [IN[1]] if IN[1] else []\ncm = IN[2] if IN[2] is not None else 100\ngm = IN[3] if IN[3] is not None else 300\n\nss = uwl(subjects_raw)\nos = uwl(obstacles_raw)\n\ner = []\nif not ss:\n    er.append(\"No MEP subjects selected.\")\nif not os:\n    er.append(\"No obstacle models selected.\")\n\nif er:\n    OUT = \"\\n\".join([\"ERROR: \" + e for e in er])\nelse:\n    sup = []\n    sk = []\n    for e in ss:\n        if cid(e) in SUP:\n            sup.append(e)\n        else:\n            cn = e.Category.Name if e.Category else \"Unknown\"\n            sk.append((e.Id.IntegerValue, \"SKIP_NOT_PIPE_DUCT\", cn))\n    if not sup:\n        msg = \"No supported MEP (Pipe/Duct) in selection.\"\n        if sk:\n            msg += \"\\nSkipped: \" + \", \".join(\n                \"#{} ({})\".format(s[0], s[2]) for s in sk)\n        OUT = msg\n    else:\n        se = [v for v in [ge(e, doc) for e in sup] if v]\n        oee = [v for v in [ge(e, doc) for e in os] if v]\n        if not oee:\n            OUT = \"ERROR: Could not read obstacle geometry.\"\n        else:\n            cd = det(se, oee, cm)\n            cd = mzn(cd, gm)\n            txt, cc, sc = rpt(cd, sk)\n            OUT = txt\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "4d5a2c9b-6b6d-4895-99bf-85950d600f5e",
