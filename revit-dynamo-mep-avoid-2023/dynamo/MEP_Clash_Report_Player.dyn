    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# MEP Clash Report — Dynamo Player (Phase 1)\n# =============================================\n# Detects vertical clearance violations between\n# selected MEP (Pipe/Duct) and obstacle models.\n# Includes insulation in measurement.\n# Does NOT modify the model.\n\nimport clr\nclr.AddReference(\"RevitAPI\")\nclr.AddReference(\"RevitServices\")\nclr.AddReference(\"RevitNodes\")\n\nfrom Autodesk.Revit.DB import (\n    FilteredElementCollector, BuiltInCategory,\n    BoundingBoxXYZ, XYZ, ElementId,\n)\nfrom Autodesk.Revit.DB.Plumbing import PipeInsulation\nfrom Autodesk.Revit.DB.Mechanical import DuctInsulation\nfrom RevitServices.Persistence import DocumentManager\n\nimport Revit\nclr.ImportExtensions(Revit.Elements)\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nFPM = 1.0 / 304.8\n\nSUP = {\n    int(BuiltInCategory.OST_PipeCurves),\n    int(BuiltInCategory.OST_DuctCurves),\n}\n\ndef uw(e):\n    try: return e.InternalElement\n    except: return e\n\ndef uwl(els):\n    if not isinstance(els, (list, tuple)): els = [els]\n    return [uw(e) for e in els if e is not None]\n\ndef cid(e):\n    return e.Category.Id.IntegerValue if e.Category else -1\n\ndef f2m(ft): return ft / FPM\n\nclass Env(object):\n    __slots__ = (\"eid\",\"mnx\",\"mny\",\"mnz\",\"mxx\",\"mxy\",\"mxz\",\"ins\",\"cat\")\n    def __init__(s,eid,mnx,mny,mnz,mxx,mxy,mxz,ins,cat):\n        s.eid=eid;s.mnx=mnx;s.mny=mny;s.mnz=mnz\n        s.mxx=mxx;s.mxy=mxy;s.mxz=mxz;s.ins=ins;s.cat=cat\n    @property\n    def otz(s): return s.mxz\n    @property\n    def obz(s): return s.mnz\n    def oxy(s,o):\n        return s.mnx<o.mxx and s.mxx>o.mnx and s.mny<o.mxy and s.mxy>o.mny\n\ndef fi(doc,hid):\n    out=[]\n    for b,c in [(BuiltInCategory.OST_PipeInsulations,PipeInsulation),\n                (BuiltInCategory.OST_DuctInsulations,DuctInsulation)]:\n        try:\n            col=FilteredElementCollector(doc).OfCategory(b).WhereElementIsNotElementType().ToElements()\n            for i in col:\n                if i.HostElementId==hid: out.append(i)\n        except: pass\n    return out\n\ndef ge(elem,doc):\n    bb=elem.get_BoundingBox(None)\n    if bb is None: return None\n    hid=elem.Id\n    ins=fi(doc,hid)\n    hi=len(ins)>0\n    mnx,mny,mnz=bb.Min.X,bb.Min.Y,bb.Min.Z\n    mxx,mxy,mxz=bb.Max.X,bb.Max.Y,bb.Max.Z\n    for i in ins:\n        ib=i.get_BoundingBox(None)\n        if ib is None: continue\n        mnx=min(mnx,ib.Min.X);mny=min(mny,ib.Min.Y);mnz=min(mnz,ib.Min.Z)\n        mxx=max(mxx,ib.Max.X);mxy=max(mxy,ib.Max.Y);mxz=max(mxz,ib.Max.Z)\n    cn=elem.Category.Name if elem.Category else \"\"\n    return Env(hid.IntegerValue,mnx,mny,mnz,mxx,mxy,mxz,hi,cn)\n\nclass CZ(object):\n    __slots__=(\"sid\",\"oids\",\"me\",\"oes\",\"gap\",\"req\",\"wbz\",\"ox0\",\"ox1\",\"oy0\",\"oy1\",\"sk\")\n    def __init__(s,sid,me,oe,gap,req):\n        s.sid=sid;s.oids=[oe.eid];s.me=me;s.oes=[oe]\n        s.gap=gap;s.req=req;s.wbz=oe.obz\n        s.ox0=max(me.mnx,oe.mnx);s.ox1=min(me.mxx,oe.mxx)\n        s.oy0=max(me.mny,oe.mny);s.oy1=min(me.mxy,oe.mxy)\n        s.sk=None\n    @property\n    def ic(s): return s.gap<s.req\n    def mg(s,o):\n        s.oids.extend(o.oids);s.oes.extend(o.oes)\n        s.wbz=min(s.wbz,o.wbz);s.gap=min(s.gap,o.gap)\n        s.ox0=min(s.ox0,o.ox0);s.ox1=max(s.ox1,o.ox1)\n        s.oy0=min(s.oy0,o.oy0);s.oy1=max(s.oy1,o.oy1)\n\ndef det(se,oe,cm):\n    rq=cm*FPM;out={}\n    for m in se:\n        zs=[]\n        for o in oe:\n            if not m.oxy(o): continue\n            if m.mnz>=o.mxz: g=m.mnz-o.mxz\n            elif o.mnz>=m.mxz: g=o.mnz-m.mxz\n            else: g=-1.0\n            z=CZ(m.eid,m,o,g,rq)\n            if z.ic: zs.append(z)\n        if zs: out[m.eid]=zs\n    return out\n\ndef mz(cd,gm):\n    mg=gm*FPM\n    for sid,zs in cd.items():\n        if len(zs)<=1: continue\n        zs.sort(key=lambda z:z.ox0)\n        mr=[zs[0]]\n        for z in zs[1:]:\n            p=mr[-1]\n            if (z.ox0-p.ox1)<mg and (p.oy0<z.oy1 and p.oy1>z.oy0): p.mg(z)\n            else: mr.append(z)\n        cd[sid]=mr\n    return cd\n\ndef rpt(cd,sk):\n    ls=[];cc=0\n    ls.append(\"=\"*60)\n    ls.append(\"  MEP CLASH / CLEARANCE REPORT\")\n    ls.append(\"  Clearance target (incl. insulation)\")\n    ls.append(\"=\"*60)\n    ls.append(\"\")\n    if not cd and not sk:\n        ls.append(\"No clashes detected. All clear.\")\n        return \"\\n\".join(ls),0,len(sk)\n    for sid,zones in sorted(cd.items()):\n        for z in zones:\n            cc+=1\n            ls.append(\"[CLASH] Subject #{} ({})\".format(sid,z.me.cat))\n            ls.append(\"  vs Obstacle(s): {}\".format(\", \".join(\"#{}\".format(o) for o in z.oids)))\n            gm=f2m(z.gap);rm=f2m(z.req)\n            if z.gap<0: ls.append(\"  Gap: INTERSECTING\")\n            else: ls.append(\"  Gap: {:.0f} mm  (required: {:.0f} mm)\".format(gm,rm))\n            ls.append(\"  MEP top Z: {:.1f} mm | Obstacle bottom Z: {:.1f} mm\".format(f2m(z.me.otz),f2m(z.wbz)))\n            ls.append(\"  MEP insulated: {}\".format(\"Yes\" if z.me.ins else \"No\"))\n            for oe in z.oes:\n                ls.append(\"    Obs #{} ({}) insulated: {}\".format(oe.eid,oe.cat,\"Yes\" if oe.ins else \"No\"))\n            ls.append(\"\")\n    if sk:\n        ls.append(\"-\"*40)\n        ls.append(\"SKIPPED (unsupported type):\")\n        for sid,r,d in sk:\n            ls.append(\"  #{} - {} ({})\".format(sid,r,d))\n        ls.append(\"\")\n    sc=len(sk)\n    ls[4]=\"Clashes: {}  |  Skipped: {}\".format(cc,sc)\n    return \"\\n\".join(ls),cc,sc\n\n# ── MAIN ──\nsr=IN[0] if isinstance(IN[0],list) else [IN[0]] if IN[0] else []\nor_=IN[1] if isinstance(IN[1],list) else [IN[1]] if IN[1] else []\ncm=IN[2] if IN[2] is not None else 100\ngm=IN[3] if IN[3] is not None else 300\n\nss=uwl(sr);os=uwl(or_)\ner=[]\nif not ss: er.append(\"No MEP subjects selected.\")\nif not os: er.append(\"No obstacle models selected.\")\nif er:\n    OUT=[\"\\n\".join([\"ERROR: \"+e for e in er]),0,0]\nelse:\n    sup=[];sk=[]\n    for e in ss:\n        if cid(e) in SUP: sup.append(e)\n        else:\n            cn=e.Category.Name if e.Category else \"Unknown\"\n            sk.append((e.Id.IntegerValue,\"SKIP_NOT_PIPE_DUCT\",cn))\n    if not sup:\n        m=\"No supported MEP (Pipe/Duct) in selection.\"\n        if sk: m+=\"\\nSkipped: \"+\", \".join(\"#{} ({})\".format(s[0],s[2]) for s in sk)\n        OUT=[m,0,len(sk)]\n    else:\n        se=[v for v in [ge(e,doc) for e in sup] if v]\n        oe=[v for v in [ge(e,doc) for e in os] if v]\n        if not oe:\n            OUT=[\"ERROR: Could not read obstacle geometry.\",0,0]\n        else:\n            cd=det(se,oe,cm)\n            cd=mz(cd,gm)\n            txt,cc,sc=rpt(cd,sk)\n            OUT=[txt,cc,sc]\n",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "python-main-guid-0005",
