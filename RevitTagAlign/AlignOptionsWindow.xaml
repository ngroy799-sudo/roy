<Window x:Class="RevitTagAlign.AlignOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure" Height="590" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F0F0">
    <Window.Resources>
        <Style x:Key="CornerBtn" TargetType="RadioButton">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" BorderBrush="#888" BorderThickness="1" Background="White" CornerRadius="2" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#E8F4FC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F9FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Corner presets -->
            <UniformGrid Grid.Column="0" Rows="2" Columns="2" Margin="0,0,8,0">
                <RadioButton x:Name="rbUL" Style="{StaticResource CornerBtn}" IsChecked="True" GroupName="Corner">
                    <StackPanel Width="200">
                        <Canvas Width="180" Height="90">
                            <TextBlock Canvas.Left="8" Canvas.Top="4" Text="SAMPLE 1" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Canvas.Left="8" Canvas.Top="22" Text="SAMPLE 2" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Canvas.Left="8" Canvas.Top="40" Text="SAMPLE 3" FontSize="10" FontWeight="Bold"/>
                            <Line X1="70" Y1="10" X2="150" Y2="10" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="150" Y1="10" X2="165" Y2="75" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="70" Y1="28" X2="150" Y2="28" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="150" Y1="28" X2="165" Y2="75" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="70" Y1="46" X2="150" Y2="46" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="150" Y1="46" X2="165" Y2="75" Stroke="Black" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="160" Canvas.Top="70" Width="8" Height="8" Fill="Black"/>
                        </Canvas>
                        <TextBlock Text="• : POINT TO PICK ON SCREEN" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="rbUR" Style="{StaticResource CornerBtn}" GroupName="Corner">
                    <StackPanel Width="200">
                        <Canvas Width="180" Height="90">
                            <TextBlock Canvas.Left="100" Canvas.Top="4" Text="SAMPLE 1" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Canvas.Left="100" Canvas.Top="22" Text="SAMPLE 2" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Canvas.Left="100" Canvas.Top="40" Text="SAMPLE 3" FontSize="10" FontWeight="Bold"/>
                            <Line X1="100" Y1="10" X2="30" Y2="10" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="30" Y1="10" X2="15" Y2="75" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="100" Y1="28" X2="30" Y2="28" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="30" Y1="28" X2="15" Y2="75" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="100" Y1="46" X2="30" Y2="46" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="30" Y1="46" X2="15" Y2="75" Stroke="Black" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="70" Width="8" Height="8" Fill="Black"/>
                        </Canvas>
                        <TextBlock Text="• : POINT TO PICK ON SCREEN" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="rbLL" Style="{StaticResource CornerBtn}" GroupName="Corner">
                    <StackPanel Width="200">
                        <Canvas Width="180" Height="90">
                            <Ellipse Canvas.Left="160" Canvas.Top="8" Width="8" Height="8" Fill="Black"/>
                            <Line X1="165" Y1="15" X2="150" Y2="55" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="150" Y1="55" X2="70" Y2="55" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="165" Y1="15" X2="150" Y2="70" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="150" Y1="70" X2="70" Y2="70" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="165" Y1="15" X2="150" Y2="85" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="150" Y1="85" X2="70" Y2="85" Stroke="Black" StrokeThickness="1"/>
                            <TextBlock Canvas.Left="8" Canvas.Top="48" Text="SAMPLE 1" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Canvas.Left="8" Canvas.Top="63" Text="SAMPLE 2" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Canvas.Left="8" Canvas.Top="78" Text="SAMPLE 3" FontSize="10" FontWeight="Bold"/>
                        </Canvas>
                        <TextBlock Text="• : POINT TO PICK ON SCREEN" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="rbLR" Style="{StaticResource CornerBtn}" GroupName="Corner">
                    <StackPanel Width="200">
                        <Canvas Width="180" Height="90">
                            <Ellipse Canvas.Left="10" Canvas.Top="8" Width="8" Height="8" Fill="Black"/>
                            <Line X1="15" Y1="15" X2="30" Y2="55" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="30" Y1="55" X2="100" Y2="55" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="15" Y1="15" X2="30" Y2="70" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="30" Y1="70" X2="100" Y2="70" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="15" Y1="15" X2="30" Y2="85" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="30" Y1="85" X2="100" Y2="85" Stroke="Black" StrokeThickness="1"/>
                            <TextBlock Canvas.Left="100" Canvas.Top="48" Text="SAMPLE 1" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Canvas.Left="100" Canvas.Top="63" Text="SAMPLE 2" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Canvas.Left="100" Canvas.Top="78" Text="SAMPLE 3" FontSize="10" FontWeight="Bold"/>
                        </Canvas>
                        <TextBlock Text="• : POINT TO PICK ON SCREEN" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <!-- Right options -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <CheckBox x:Name="cbPickAngleMouse" Content="Pick Angle then Tag Position (2 clicks)" IsChecked="True" Margin="0,4"
                          ToolTip="Click1 = red arrow angle, Click2 = tag text position"/>
                <CheckBox x:Name="cbSwitchSide" Content="Switch Pick Point Side" Margin="0,4"/>
                <CheckBox x:Name="cbAttachedEnd" Content="Force Attached End Tags" Margin="0,4"
                          ToolTip="ON = force Attached. OFF = keep each tag's original Attached/Free setting."/>
                <CheckBox x:Name="cbKeepSelection" Content="Keep Selection After Use" Margin="0,4"/>
                <CheckBox x:Name="cbTurnSnapsOff" Content="Turn Snaps Off" Margin="0,4"/>

                <GroupBox Header="Horizontal Justification (TextNotes Only)" Margin="0,16,0,0" Padding="6">
                    <StackPanel>
                        <RadioButton x:Name="rbJustUnchanged" Content="Unchanged Justification" GroupName="Just" Margin="0,2"/>
                        <RadioButton x:Name="rbJustLeft" Content="Left Justification" GroupName="Just" Margin="0,2"/>
                        <RadioButton x:Name="rbJustRight" Content="Right Justification" GroupName="Just" Margin="0,2"/>
                        <RadioButton x:Name="rbJustAuto" Content="Automatic Justification" GroupName="Just" IsChecked="True" Margin="0,2"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- Angle + spacing -->
        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Angle fallback (°)" VerticalAlignment="Center" Margin="0,0,8,8"
                       ToolTip="Used only when 'Pick Angle then Tag Position' is OFF. When ON, angle comes from mouse (red arrow)."/>
            <Slider x:Name="sliderAngle" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="90" Value="45"
                    TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,8"
                    ValueChanged="SliderAngle_Changed"/>
            <TextBox x:Name="tbAngle" Grid.Row="0" Grid.Column="2" Width="50" Text="45" VerticalAlignment="Center" Margin="0,0,0,8"
                     LostFocus="TbAngle_LostFocus"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4">
                <CheckBox x:Name="cbConstantLanding" Content="Constant Landing" VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="ConstantLanding_Changed" Unchecked="ConstantLanding_Changed"/>
                <TextBlock Text="Landing Distance" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="tbLanding" Width="90" Text="1524" IsEnabled="False" VerticalAlignment="Center"/>
                <TextBlock Text=" mm" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Vertical Spacing" VerticalAlignment="Center" Width="110"/>
                <TextBox x:Name="tbVertSpacing" Width="90" Text="60.96" VerticalAlignment="Center"/>
                <TextBlock Text=" mm" VerticalAlignment="Center" Margin="4,0,24,0"/>
                <CheckBox x:Name="cbIntermittent" Content="Intermittent Alignment" VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="Intermittent_Changed" Unchecked="Intermittent_Changed"/>
                <TextBlock Text="Horizontal Spacing" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="tbHorizSpacing" Width="90" Text="3048" IsEnabled="False" VerticalAlignment="Center"/>
                <TextBlock Text=" mm" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="txtSettingsPath" TextWrapping="Wrap" FontSize="10" Foreground="#555"
                           ToolTip="Settings file path (%AppData% = AppData\Roaming)"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Save Settings" Width="100" Margin="0,0,6,0" Click="SaveSettings_Click"
                            ToolTip="Save now without running Align"/>
                    <Button Content="Open Folder" Width="90" Click="OpenFolder_Click"
                            ToolTip="Open the settings folder in Explorer"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Help" Width="70" Margin="0,0,8,0" Click="Help_Click"/>
                <Button Content="Proceed" Width="90" Margin="0,0,8,0" Click="Proceed_Click" IsDefault="True" FontWeight="SemiBold"/>
                <Button Content="Cancel" Width="80" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
