        {"Id": "pi9", "Name": "IN[9]", "Description": "ReportPath", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false}
      ],
      "Outputs": [
        {"Id": "po0", "Name": "OUT", "Description": "Player results list", "UsingDefaultValue": false, "Level": 2, "UseLevels": false, "KeepListStructure": false}
      ],
      "Replication": "Disabled",
      "Description": "Loads python/player_run_all.py from ProjectRoot (Player-safe OUT)",
      "Script": "import sys, os\ndef _s(v):\n    if v is None:\n        return ''\n    try:\n        return v.ToString() if hasattr(v, 'ToString') else str(v)\n    except:\n        return str(v)\nroot = _s(IN[0]).strip().strip('\"')\npy = os.path.join(root, 'python')\nif not root or not os.path.isdir(py):\n    OUT = ['ProjectRoot invalid: ' + root, '', 0, 0, 'Set ProjectRoot to folder with python/ and config/', 'ERROR']\nelse:\n    if py not in sys.path:\n        sys.path.insert(0, py)\n    script = os.path.join(py, 'player_run_all.py')\n    ns = {'IN': IN, 'OUT': None}\n    f = open(script, 'r')\n    code = f.read()\n    f.close()\n    try:\n        exec(code, ns)\n        out = ns.get('OUT')\n        if out is None or not isinstance(out, list) or len(out) < 6:\n            OUT = ['Bad OUT from player_run_all', '', 0, 0, 'Script did not return 6 items', 'ERROR']\n        else:\n            OUT = [ _s(out[0]), _s(out[1]), int(out[2] or 0), int(out[3] or 0), _s(out[4]) or 'none', _s(out[5]) or 'OK' ]\n    except Exception as ex:\n        OUT = ['Loader exception: ' + str(ex), '', 0, 0, str(ex), 'ERROR']"
    },
